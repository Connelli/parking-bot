# Copy to parking-bot.env (next to config.yaml). Controls the runner service
# only -- the webapp never reserves anything, so it has no dry-run mode.
#
# Start here. Watch `journalctl -u parking-bot-runner -f` and confirm it's
# finding the right dates/spots before turning real reservations on.
RUNNER_ARGS=--dry-run

# Once you trust it, change the line above to RUNNER_ARGS= (empty) and:
#   sudo systemctl restart parking-bot-runner
